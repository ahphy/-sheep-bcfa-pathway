strict digraph "" {
	graph [bgcolor=transparent,
		nodesep=.2,
		outputorder=edgesfirst,
		pad=.05,
		rankdir=LR,
		ranksep=.30,
		splines=line
	];
	node [fixedsize=true,
		height=1.48,
		shape=box,
		style=invis
	];
	edge [arrowsize=.7,
		color="#263b47",
		fontcolor="#24776b",
		fontname="Noto Sans CJK SC",
		fontsize=17,
		penwidth=1.6,
		style=dashed
	];
	s0	[width=2.1];
	s1	[width=2.9];
	s0 -> s1	[label="+ 丙二酰-CoA"];
	s2	[width=3.3];
	s1 -> s2	[fontcolor="#b96324",
		label="+ 支链供体"];
	s3	[width=3.8];
	s2 -> s3	[label="+ 丙二酰-CoA"];
	s4	[width=3.8];
	s3 -> s4	[fontcolor="#263b47",
		label=水解];
}
